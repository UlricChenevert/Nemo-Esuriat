bin/**
obj/**
node_modules/**
wwwroot/
# Chess emits its browser build in place (game.html imports ./Game.js as a sibling).
# Scoped to Chess: a blanket *.js would swallow hand-written framework scripts.
Client/Scripts/Chess/**/*.js
Client/Scripts/Chess/**/*.js.map
Client/Scripts/Chess/**/*.d.ts
Client/Scripts/Chess/**/*.d.ts.map

# Same for Unknown V2 (game.html imports ./Game.js as a sibling).
Client/Scripts/UnknownV2/**/*.js
Client/Scripts/UnknownV2/**/*.js.map
Client/Scripts/UnknownV2/**/*.d.ts
Client/Scripts/UnknownV2/**/*.d.ts.map
